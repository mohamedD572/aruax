rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Aurex User Profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Cloud Mining Investments & Rigs
    match /investments/{investmentId} {
      allow read, write: if true;
    }

    // Deposit Requests & Proofs
    match /deposits/{depositId} {
      allow read, write: if true;
    }

    // Withdrawal Requests
    match /withdrawals/{withdrawalId} {
      allow read, write: if true;
    }

    // Platform Deposit Wallets
    match /wallets/{walletId} {
      allow read, write: if true;
    }

    // Platform Settings & Rates
    match /settings/{docId} {
      allow read, write: if true;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Live Customer Support Chat Messages
    match /support_messages/{messageId} {
      allow read, write: if true;
    }

    // Copy Trading Traders & Positions
    match /copy_traders/{traderId} {
      allow read, write: if true;
    }

    match /copy_positions/{positionId} {
      allow read, write: if true;
    }

    // Activity Audit Logs
    match /activity_logs/{logId} {
      allow read, write: if true;
    }

    // Transactions History
    match /transactions/{txId} {
      allow read, write: if true;
    }
  }
}
